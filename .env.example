# The MCP server reads MAILTEA_API_TOKEN (not MAILTEA_API_KEY — the REST/SDK
# examples use that name). Create the key at https://studio.mailtea.app/api-keys
MAILTEA_API_TOKEN=mt_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic key for the model half of the agent: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# An address on a domain you have verified in Mailtea. The agent is told to
# send from this, so it never has to guess a sender.
MAILTEA_FROM=Acme <hello@acme.com>

# Optional. Scopes the MCP tools the agent can see, by dotted-name prefix.
# All 162 tool schemas at once is a large prompt; this trims it to what the
# task needs. Unset means the default: email., contact., topic.
# MAILTEA_MCP_TOOLS=email.,contact.,topic.,analytics.

# Optional. Pins the agent to one publication when your key spans several.
# MAILTEA_PUBLICATION_ID=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Overrides the API host, which defaults to https://api.mailtea.app.
# MAILTEA_API_BASE_URL=https://api.mailtea.app
